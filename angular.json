{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": [
      "angular-eslint"
    ]
  },
  "newProjectRoot": "projects",
  "projects": {
    "front-nx036": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "none",
          "skipTests": false,
          "changeDetection": "OnPush"
        },
        "@schematics/angular:directive": {
          "skipTests": false
        },
        "@schematics/angular:service": {
          "skipTests": false
        },
        "@schematics/angular:pipe": {
          "skipTests": false
        },
        "@schematics/angular:guard": {
          "skipTests": false
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "nx",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "server": "src/main.server.ts",
            "outputMode": "static",
            "security": {
              "allowedHosts": []
            }
          },
          "configurations": {
            "production": {
              "optimization": true,
              "extractLicenses": true,
              "sourceMap": false,
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "900kB",
                  "maximumError": "1.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.pro.ts"
                }
              ]
            },
            "local": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "none"
            },
            "des": {
              "optimization": true,
              "extractLicenses": true,
              "sourceMap": false,
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "900kB",
                  "maximumError": "1.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.des.ts"
                }
              ]
            },
            "pre": {
              "optimization": true,
              "extractLicenses": true,
              "sourceMap": false,
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "900kB",
                  "maximumError": "1.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.pre.ts"
                }
              ]
            },
            "pro": {
              "optimization": true,
              "extractLicenses": true,
              "sourceMap": false,
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "900kB",
                  "maximumError": "1.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.pro.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "pro"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "local": {
              "buildTarget": "front-nx036:build:local"
            },
            "des": {
              "buildTarget": "front-nx036:build:des"
            },
            "pre": {
              "buildTarget": "front-nx036:build:pre"
            },
            "pro": {
              "buildTarget": "front-nx036:build:pro"
            }
          },
          "defaultConfiguration": "local",
          "options": {
            "proxyConfig": "proxy.conf.json",
            "port": 3004,
            "host": "0.0.0.0"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "runnerConfig": true,
            "setupFiles": [
              "src/test-setup.ts"
            ],
            "coverage": false,
            "coverageInclude": [
              "src/app/**/*.ts",
              "src/main.ts"
            ],
            "coverageReporters": [
              "text",
              "lcov"
            ],
            "coverageExclude": [
              "src/test-setup.ts",
              "src/**/*.spec.ts",
              "src/main.server.ts",
              "src/app/shared/i18n/**",
              "src/app/shared/data/**",
              "src/app/shared/content/**"
            ],
            "coverageThresholds": {
              "statements": 90,
              "branches": 85,
              "functions": 90,
              "lines": 90
            },
            "buildTarget": "front-nx036:build:local",
            "providersFile": "src/test-providers.ts"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    }
  }
}
